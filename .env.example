# Copy to .env — values from Supabase Dashboard → Project Settings → API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…). Never put the secret key (sb_secret_…) in this project.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Set to true only after enabling Google in Supabase → Authentication → Sign In / Providers
VITE_ENABLE_GOOGLE=false
